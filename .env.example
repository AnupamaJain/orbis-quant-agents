# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set the provider you want as primary. Options: openai, google, anthropic, xai, ollama
LLM_PROVIDER=anthropic
DEEP_THINK_LLM=claude-sonnet-4-6
QUICK_THINK_LLM=claude-haiku-4-5-20251001

# API keys — only the one matching LLM_PROVIDER is required
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# ── Ollama (free, local or self-hosted) ──────────────────────────────────────
# URL of your Ollama instance. Defaults to http://localhost:11434/v1 if unset.
# For a laptop on another machine: http://192.168.x.x:11434/v1
# For a Cloudflare Tunnel: https://ollama.your-domain.com/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Provider fallback ─────────────────────────────────────────────────────────
# When the primary provider returns 429 (quota) or 503 (overloaded), the MCP
# server automatically retries with this fallback provider.
FALLBACK_LLM_PROVIDER=
FALLBACK_DEEP_THINK_LLM=
FALLBACK_QUICK_THINK_LLM=
# Optional: custom base URL for the fallback (e.g. a remote Ollama instance).
# Omit if FALLBACK_LLM_PROVIDER=ollama — it will use OLLAMA_BASE_URL automatically.
FALLBACK_BASE_URL=

# ── MCP Server ────────────────────────────────────────────────────────────────
MCP_PORT=8001
# Shared secret for the public MCP endpoint. Give this to anyone you want to
# allow access. Leave blank to disable auth (not recommended for public servers).
MCP_API_KEY=
MCP_RATE_LIMIT=30
